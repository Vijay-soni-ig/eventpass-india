# Staging only — never commit real values.
STAGING_FRONTEND_URL=https://staging.example.com
STAGING_API_URL=https://staging-api.example.com
STAGING_FRONTEND_PORT=8080

DATABASE_URL=postgresql://STAGING_DB_USER:STAGING_DB_PASSWORD@STAGING_DB_HOST:5432/STAGING_DB_NAME
JWT_SECRET=replace-with-a-unique-staging-secret
JWT_EXPIRES_IN=8h
JWT_ISSUER=exhibittix
JWT_AUDIENCE=exhibittix-staging
CORS_ORIGINS=https://staging.example.com

# Keep payment credentials empty until a staging/test account is available.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_PROVIDER=mock

# Staging must use object storage rather than local uploads.
STORAGE_PROVIDER=s3
STORAGE_S3_REGION=
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_ENDPOINT=
STORAGE_PUBLIC_BASE_URL=

NOTIFICATION_DISPATCHER_ENABLED=false
EVENT_TICKET_RESERVATION_EXPIRY_ENABLED=true
