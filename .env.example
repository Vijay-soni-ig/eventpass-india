# Frontend
VITE_API_URL=http://localhost:4000

# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventpass_dev
JWT_SECRET=replace-with-a-long-random-production-secret
# Comma-separated browser origins allowed to call the API in production.
# Example: https://www.exhibittix.com,https://app.exhibittix.com
CORS_ORIGINS=http://localhost:5173
# Production default is 24h. Prefer a shorter lifetime once refresh-token/session
# rotation is implemented; do not use a long-lived token for production without
# an explicit security review.
JWT_EXPIRES_IN=24h

# Razorpay (optional for local development; required for payment flows)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
