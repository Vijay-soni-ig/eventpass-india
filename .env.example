# Frontend
VITE_API_URL=http://localhost:4000

# Backend
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eventpass_dev
JWT_SECRET=replace-with-a-long-random-production-secret
# Comma-separated browser origins allowed to call the API in production.
# Example: https://www.exhibittix.com,https://app.exhibittix.com
CORS_ORIGINS=http://localhost:5173
# Auth sessions are persisted server-side and are revocable. Keep the JWT
# lifetime aligned with the session lifetime unless a reviewed refresh-token
# rotation flow is introduced.
JWT_EXPIRES_IN=8h
JWT_ISSUER=exhibittix
JWT_AUDIENCE=exhibittix-app

# Razorpay (optional for local development; required for payment flows)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Notification dispatcher (Phase 31/FP-06) — processes the notification_intents/
# notification_deliveries outbox tables. Default off: enable deliberately after
# database/provider verification. IN_APP is internal; EMAIL/PUSH remain mock
# adapters until a real provider is wired. Mock EMAIL/PUSH fail closed in
# production rather than reporting a fake successful delivery.
NOTIFICATION_DISPATCHER_ENABLED=false
NOTIFICATION_DISPATCHER_INTERVAL_MS=15000
