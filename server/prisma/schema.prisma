// =============================================================================
// ETX-EVENT-001A — UNIVERSAL EVENT FOUNDATION (additive, schema-only)
// =============================================================================
// Introduces the future universal Event domain root as a standalone set of
// tables. Nothing here is read or written by any existing route yet, and
// nothing existing (Exhibition, TicketType, Stall, FloorPlan, FloorPlanObject,
// TicketBooking, StallBooking, ExhibitionExhibitor, CheckIn, Lead, Payment,
// Refund, PaymentEvent) is modified or related to these models in this step.
// See docs/product/UNIVERSAL_EVENT_FOUNDATION.md for the full analysis and
// the planned backfill/compatibility step (ETX-EVENT-001B) that will connect
// this to Exhibition — not part of this step.

enum EventType {
  EXHIBITION
  CONFERENCE
  WORKSHOP
  SEMINAR
  CONCERT
  FESTIVAL
  SPORTS
  COMMUNITY
  OTHER
}

// Deliberately a separate enum from ExhibitionStatus (draft/live/paused/
// completed), which is untouched. PUBLISHED is the universal-naming
// equivalent of Exhibition's "live"; CANCELLED has no Exhibition equivalent
// today and is added here for event types where a terminal non-completion
// state is meaningful.
enum EventStatus {
  DRAFT
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED
}

enum EventModule {
  EXHIBITION
  REGISTRATION
  TICKETING
  EXHIBITORS
  STALL_BOOKING
  FLOOR_PLAN
  CHECK_IN
  LEADS
  SPEAKERS
  SESSIONS
  SPONSORS
  PARTNERS
  VENDORS
  VOLUNTEERS
  SEATING
  PARTICIPANTS
  ANALYTICS
}

model EventCategory {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  description      String?
  parentCategoryId String?
  // onDelete: Restrict — deleting a category that still has children must
  // fail rather than cascade, so a category tree can never be silently
  // wiped out by removing its root.
  parent           EventCategory?  @relation("EventCategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children         EventCategory[] @relation("EventCategoryHierarchy")
  active           Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           Event[]

  @@index([parentCategoryId])
  @@index([active])
  @@index([active, sortOrder])
  @@map("event_categories")
}

enum VisitorEventInteractionType {
  VIEW
  CLICK
  SAVE
  REGISTER
  PURCHASE
  CHECK_IN
  SEARCH
  RECOMMENDATION_IMPRESSION
  RECOMMENDATION_DISMISS
  RECOMMENDATION_NOT_INTERESTED
}

model Event {
  id                String                  @id @default(uuid())
  organizerId       String
  organizer         Organizer               @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  venueId           String?
  venue             Venue?                  @relation(fields: [venueId], references: [id], onDelete: SetNull)
  title             String
  // No uniqueness constraint yet: a per-organizer unique slug is the likely
  // eventual design (mirrors Organizer.slug being globally unique because
  // organizers are the tenant root, whereas events are not), but that scope
  // hasn't been decided against real routing requirements. Left nullable and
  // unconstrained rather than guessing wrong; tighten in a later step once
  // the public event-detail URL scheme for non-exhibition event types exists.
  slug              String?
  description       String?
  eventType         EventType
  categoryId        String?
  category          EventCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status            EventStatus             @default(DRAFT)
  visibility        Visibility              @default(public)
  // Same date-only semantics as Exhibition.startDate/endDate (@db.Date) —
  // deliberately not upgraded to a full timestamp here.
  startDate         DateTime?               @db.Date
  endDate           DateTime?               @db.Date
  timezone          String                  @default("Asia/Kolkata")
  venue             String?
  city              String?
  latitude          Float?
  longitude         Float?
  coverImageUrl     String?
  seoTitle          String?
  seoDescription    String?
  seoImageUrl       String?
  refundPolicy      String?
  terms             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  archivedAt        DateTime?
  moduleEnablements EventModuleEnablement[]
  registrations     EventRegistration[]
  registrationSettings EventRegistrationSettings?
  ticketTypes       EventTicketType[]
  ticketReservations EventTicketReservation[]
  ticketOrders      EventTicketOrder[]
  tickets           EventTicket[]
  ticketCheckIns    EventTicketCheckIn[]
  eventLeads         EventLead[]
  participants       EventParticipant[]
  participantContacts EventParticipantContact[]
  sessions           EventSession[]
  sponsorPackages    EventSponsorPackage[]
  sponsorProfiles    EventSponsorProfile[]
  vendorServices     EventVendorService[]
  vendorProfiles     EventVendorProfile[]
  partnerProfiles    EventPartnerProfile[]
  staffProfiles      EventStaffProfile[]
  // ETX-EVENT-001B — opposite side of Exhibition.eventId. Optional because
  // an Event created by a future non-exhibition flow (ETX-EVENT-001C+) will
  // never have one.
  exhibition        Exhibition?
  visitorInteractions VisitorEventInteraction[]

  @@index([organizerId])
  @@index([ownerId])
  @@index([venueId])
  @@index([status, visibility])
  @@index([eventType])
  @@index([categoryId])
  @@index([startDate])
  @@map("events")
}



model VisitorPreference {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredCategoryIds String[] @default([])
  preferredCities      String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([updatedAt])
  @@map("visitor_preferences")
}

model VisitorEventInteraction {
  id        String                       @id @default(uuid())
  userId    String?
  user      User?                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId   String?
  event     Event?                       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  type      VisitorEventInteractionType
  sessionId String?
  metadata  Json?
  createdAt DateTime                     @default(now())

  @@index([userId, createdAt])
  @@index([eventId, createdAt])
  @@index([userId, eventId, type, createdAt])
  @@index([sessionId, createdAt])
  @@map("visitor_event_interactions")
}

// ETX-TICKET-001 — Event-native ticket catalog foundation.
// This is deliberately additive: the existing Exhibition TicketType remains
// the operational source for legacy exhibition ticketing until the booking
// cutover is implemented. EventTicketType is the universal Event-scoped
// catalog that future Event-native bookings will consume.
enum EventTicketTypeStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model EventTicketType {
  id              String                 @id @default(uuid())
  eventId         String
  event           Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal                @default(0) @db.Decimal(10, 2)
  currency        String                 @default("INR")
  capacity        Int
  maxPerOrder     Int                    @default(10)
  maxPerAttendee  Int?
  saleStartsAt    DateTime?
  saleEndsAt      DateTime?
  status          EventTicketTypeStatus  @default(ACTIVE)
  sortOrder       Int                    @default(0)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([eventId, status, sortOrder])
  @@index([eventId, saleStartsAt, saleEndsAt])
  reservations    EventTicketReservation[]
  tickets         EventTicket[]

  @@map("event_ticket_types")
}

enum EventRegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EventRegistrationSource {
  PUBLIC
  ORGANIZER
  ADMIN
}

enum EventTicketReservationStatus {
  ACTIVE
  EXPIRED
  CANCELLED
  CONVERTED
}

model EventTicketReservation {
  id             String                         @id @default(uuid())
  eventTicketTypeId String
  eventTicketType EventTicketType              @relation(fields: [eventTicketTypeId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event                          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  attendeeName   String
  attendeeEmail  String
  attendeePhone  String?
  quantity       Int
  unitPrice      Decimal                        @db.Decimal(10, 2)
  currency       String                         @default("INR")
  status         EventTicketReservationStatus  @default(ACTIVE)
  idempotencyKey String?
  expiresAt      DateTime
  cancelledAt    DateTime?
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt
  order           EventTicketOrder?

  @@unique([userId, idempotencyKey])
  @@index([eventTicketTypeId, status, expiresAt])
  @@index([eventId, status, expiresAt])
  @@index([userId, status, expiresAt])
  @@map("event_ticket_reservations")
}

enum EventTicketStatus {
  ACTIVE
  CANCELLED
  REFUNDED
  USED
}

model EventTicket {
  id                 String              @id @default(uuid())
  eventId            String              @map("event_id")
  event              Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventTicketOrderId String              @map("event_ticket_order_id")
  eventTicketOrder   EventTicketOrder    @relation(fields: [eventTicketOrderId], references: [id], onDelete: Restrict)
  eventTicketTypeId  String              @map("event_ticket_type_id")
  eventTicketType    EventTicketType     @relation(fields: [eventTicketTypeId], references: [id], onDelete: Restrict)
  userId             String              @map("user_id")
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  attendeeName       String              @map("attendee_name")
  attendeeEmail      String              @map("attendee_email")
  attendeePhone      String?             @map("attendee_phone")
  ticketCode         String              @unique @map("ticket_code")
  qrTokenHash        String              @unique @map("qr_token_hash")
  status             EventTicketStatus   @default(ACTIVE)
  issuedAt           DateTime            @default(now()) @map("issued_at")
  checkedInAt        DateTime?           @map("checked_in_at")
  cancelledAt        DateTime?           @map("cancelled_at")
  refundedAt         DateTime?           @map("refunded_at")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  checkIns           EventTicketCheckIn[]
  eventLeads         EventLead[]

  @@index([userId, status, createdAt])
  @@index([eventId, status])
  @@index([eventTicketOrderId])
  @@index([qrTokenHash])
  @@map("event_tickets")
}

model EventTicketCheckIn {
  id            String      @id @default(uuid())
  eventTicketId String      @map("event_ticket_id")
  eventTicket   EventTicket @relation(fields: [eventTicketId], references: [id], onDelete: Cascade)
  eventId       String      @map("event_id")
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scannedByUserId String    @map("scanned_by_user_id")
  scannedByUser User      @relation("EventTicketCheckInScanner", fields: [scannedByUserId], references: [id], onDelete: Restrict)
  method        EventTicketCheckInMethod @default(QR)
  scannedAt     DateTime    @default(now()) @map("scanned_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([eventTicketId, scannedAt])
  @@index([eventId, scannedAt])
  @@index([scannedByUserId, scannedAt])
  @@map("event_ticket_check_ins")
}

enum EventTicketCheckInMethod {
  QR
  MANUAL
}

enum EventTicketOrderStatus {
  PAYMENT_PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

model EventTicketOrder {
  id              String                 @id @default(uuid())
  eventId         String
  event            Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservationId   String                 @unique
  reservation     EventTicketReservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentId       String                 @unique
  payment         Payment                @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  quantity        Int
  unitPrice       Decimal                @db.Decimal(10, 2)
  subtotal        Decimal                @db.Decimal(10, 2)
  totalAmount     Decimal                @db.Decimal(10, 2)
  currency        String                 @default("INR")
  status          EventTicketOrderStatus @default(PAYMENT_PENDING)
  idempotencyKey  String?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  tickets         EventTicket[]

  @@unique([userId, idempotencyKey])
  @@index([eventId, status, createdAt])
  @@index([userId, status, createdAt])
  @@index([paymentId])
  @@map("event_ticket_orders")
}

model EventRegistrationSettings {
  id              String   @id @default(uuid())
  eventId         String   @unique
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true)
  capacity        Int?
  requiresApproval Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("event_registration_settings")
}

model EventRegistration {
  id               String                  @id @default(uuid())
  eventId          String
  event            Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName         String
  email            String
  phone            String?
  companyName      String?
  status           EventRegistrationStatus @default(PENDING)
  source           EventRegistrationSource @default(PUBLIC)
  consentAccepted  Boolean                 @default(false)
  registeredAt     DateTime                @default(now())
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?
  idempotencyKey   String?
  metadata         Json?
  eventLeads       EventLead[]
  ticketBookings   TicketBooking[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([eventId, email])
  @@unique([eventId, idempotencyKey])
  @@unique([eventId, userId])
  @@index([eventId, status, createdAt])
  @@index([userId, eventId])
  @@index([email])
  @@map("event_registrations")
}


enum EventLeadStatus {
  NEW
  CONTACTED
  INTERESTED
  QUALIFIED
  NEGOTIATION
  CONVERTED
  LOST
  ARCHIVED
}

enum EventLeadPriority {
  LOW
  MEDIUM
  HIGH
}
enum EventLeadSource {
  QR_SCAN
  MANUAL
  REGISTRATION
  TICKET_CHECK_IN
  IMPORT
}
enum EventLeadInteractionType {
  NOTE
  CALL
  EMAIL
  WHATSAPP
  MEETING
  OTHER
}
enum EventLeadFollowUpStatus {
  OPEN
  COMPLETED
  CANCELLED
}

model EventLead {
  id                    String               @id @default(uuid())
  eventId               String
  event                 Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  exhibitorBusinessId   String?
  exhibitorBusiness     ExhibitorBusiness?   @relation(fields: [exhibitorBusinessId], references: [id], onDelete: SetNull)
  exhibitionExhibitorId String?
  exhibitionExhibitor   ExhibitionExhibitor? @relation(fields: [exhibitionExhibitorId], references: [id], onDelete: SetNull)
  stallId               String?
  stall                 Stall?               @relation(fields: [stallId], references: [id], onDelete: SetNull)
  visitorUserId         String?
  visitorUser           User?                @relation("EventLeadVisitor", fields: [visitorUserId], references: [id], onDelete: SetNull)
  registrationId        String?
  registration          EventRegistration?   @relation(fields: [registrationId], references: [id], onDelete: SetNull)
  ticketId              String?
  ticket                EventTicket?         @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  visitorName           String
  visitorEmail          String?
  visitorPhone          String?
  companyName           String?
  source                EventLeadSource      @default(MANUAL)
  status                EventLeadStatus      @default(NEW)
  priority              EventLeadPriority    @default(MEDIUM)
  notes                 String?
  assignedToUserId      String?
  assignedToUser        User?                @relation("EventLeadAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  capturedByUserId      String?
  capturedByUser        User?                @relation("EventLeadCapturedBy", fields: [capturedByUserId], references: [id], onDelete: SetNull)
  capturedAt            DateTime             @default(now())
  archivedAt            DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  interactions          EventLeadInteraction[]
  followUps             EventLeadFollowUp[]
  @@index([eventId, status, createdAt])
  @@index([eventId, exhibitorBusinessId, status])
  @@index([exhibitorBusinessId, createdAt])
  @@index([visitorEmail])
  @@index([visitorPhone])
  @@index([ticketId])
  @@index([registrationId])
  // A ticket can produce at most one lead per exhibitor for an event.
  // This is the database-level idempotency guarantee for universal ticket capture.
  @@unique([eventId, exhibitorBusinessId, ticketId])
  @@map("event_leads")
}

model EventLeadInteraction {
  id              String                   @id @default(uuid())
  leadId          String
  lead            EventLead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type            EventLeadInteractionType  @default(NOTE)
  note            String
  createdByUserId String
  createdByUser   User                     @relation("EventLeadInteractionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime                 @default(now())
  @@index([leadId, createdAt])
  @@index([createdByUserId, createdAt])
  @@map("event_lead_interactions")
}

model EventLeadFollowUp {
  id               String                  @id @default(uuid())
  leadId           String
  lead             EventLead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignedToUserId String
  assignedToUser   User                    @relation("EventLeadFollowUpAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  dueAt            DateTime
  status           EventLeadFollowUpStatus @default(OPEN)
  note             String?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  @@index([leadId, status, dueAt])
  @@index([assignedToUserId, status, dueAt])
  @@map("event_lead_follow_ups")
}

enum EventParticipantType {
  SPEAKER
  SPONSOR
  VENDOR
  PARTNER
  STAFF
  CUSTOM
}

enum EventParticipantStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}



enum EventParticipantContactType {
  PRIMARY
  SECONDARY
  OPERATIONS
  SALES
  OTHER
}

model EventParticipantContact {
  id              String                       @id @default(uuid())
  eventId         String                       @map("event_id")
  event            Event                        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId    String                       @map("participant_id")
  participant      EventParticipant             @relation(fields: [participantId], references: [id], onDelete: Cascade)
  name            String
  designation     String?
  contactType     EventParticipantContactType  @default(SECONDARY) @map("contact_type")
  email           String?
  phone           String?
  whatsapp        String?
  notes           String?
  isPrimary       Boolean                      @default(false) @map("is_primary")
  archivedAt      DateTime?                    @map("archived_at")
  createdAt       DateTime                     @default(now()) @map("created_at")
  updatedAt       DateTime                     @updatedAt @map("updated_at")

  @@index([eventId, participantId, archivedAt, createdAt])
  @@index([participantId, isPrimary, archivedAt])
  @@index([participantId, email])
  @@map("event_participant_contacts")
}
model EventParticipant {
  id              String                 @id @default(uuid())
  eventId         String
  event           Event                  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantType EventParticipantType
  customType      String?
  name            String
  title           String?
  organization    String?
  bio             String?
  email           String?
  phone           String?
  website         String?
  photoUrl        String?
  sortOrder       Int                    @default(0)
  status          EventParticipantStatus @default(ACTIVE)
  isPublic        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  archivedAt      DateTime?
  sessionSpeakers EventSessionSpeaker[] @relation("EventSessionSpeakerParticipant")
  sponsorProfile  EventSponsorProfile?
  vendorProfile   EventVendorProfile?
  partnerProfile  EventPartnerProfile?
  staffProfile    EventStaffProfile?

  media             EventParticipantMedia[]
  documents         EventParticipantDocument[]
  contacts          EventParticipantContact[]
  @@index([eventId, participantType, status])
  @@index([eventId, isPublic, sortOrder])
  @@index([eventId, name])
  @@map("event_participants")
}


model EventPartnerProfile {
  id                   String           @id @default(uuid())
  eventId              String
  event                Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId        String           @unique
  participant           EventParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
