model EventSponsorProfile {
  id                 String               @id @default(uuid())
  eventId            String
  event              Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  participantId      String               @unique
  participant        EventParticipant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  packageId          String?
  package            EventSponsorPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  amountOverride     Decimal?
  currency           String               @default("INR")
  benefitsOverride   Json?
  deliverablesOverride Json?
  logoUrl            String?
  brandPrimaryColor  String?
  brandSecondaryColor String?
  displayWebsite     String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([eventId, packageId])
  @@map("event_sponsor_profiles")
}

enum EventSessionStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventSessionSpeakerRole {
  PRIMARY
  MODERATOR
  PANELIST
}

model EventSession {
  id          String             @id @default(uuid())
  eventId     String
  event       Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?
  date        DateTime           @db.Date
  startTime   String
  endTime     String
  timezone    String             @default("Asia/Kolkata")
  room       String?
  status      EventSessionStatus @default(DRAFT)
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  speakers    EventSessionSpeaker[]

  @@index([eventId, date, startTime])
  @@index([eventId, status, sortOrder])
  @@map("event_sessions")
}

model EventSessionSpeaker {
  id            String                  @id @default(uuid())
  sessionId     String
  session       EventSession             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participantId String
  participant   EventParticipant        @relation("EventSessionSpeakerParticipant", fields: [participantId], references: [id], onDelete: Cascade)
  role          EventSessionSpeakerRole  @default(PRIMARY)
  sortOrder     Int                     @default(0)
  createdAt     DateTime                @default(now())

  @@unique([sessionId, participantId])
  @@index([participantId])
  @@index([sessionId, role, sortOrder])
  @@map("event_session_speakers")
}

model EventModuleEnablement {
  id         String      @id @default(uuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  moduleType EventModule
  enabled    Boolean     @default(true)
  config     Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([eventId, moduleType])
  @@index([eventId])
  @@index([moduleType, enabled])
  @@map("event_module_enablements")
}


enum EventParticipantMediaKind {
  PROFILE_IMAGE
  LOGO
  GALLERY
}

enum EventParticipantMediaVisibility {
  PUBLIC
  PRIVATE
}

model EventParticipantMedia {
  id               String                         @id @default(uuid())
  participantId    String
  participant      EventParticipant               @relation(fields: [participantId], references: [id], onDelete: Cascade)
  kind             EventParticipantMediaKind
  visibility       EventParticipantMediaVisibility @default(PUBLIC)
  fileUrl          String
  mimeType         String
  fileSizeBytes    Int
  altText          String?
  caption          String?
  sortOrder        Int                            @default(0)
  active           Boolean                        @default(true)
  archivedAt       DateTime?
  uploadedByUserId String?
  uploadedByUser   User?                          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime                       @default(now())
  updatedAt        DateTime                       @updatedAt

  @@index([participantId, kind, active, archivedAt])
  @@index([participantId, visibility, active, archivedAt, sortOrder])
  @@map("event_participant_media")
}

enum EventParticipantDocumentKind {
  IDENTITY
  CERTIFICATE
  AGREEMENT
  OTHER
}

model EventParticipantDocument {
  id               String                         @id @default(uuid())
  participantId    String                         @map("participant_id")
  participant      EventParticipant               @relation(fields: [participantId], references: [id], onDelete: Cascade)
  name             String
  kind             EventParticipantDocumentKind
  description      String?
  fileUrl          String                         @map("file_url")
  mimeType         String                         @map("mime_type")
  fileSizeBytes    Int                            @map("file_size_bytes")
  uploadedByUserId String?                        @map("uploaded_by_user_id")
  uploadedByUser   User?                          @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  archivedAt       DateTime?                      @map("archived_at")
  createdAt        DateTime                       @default(now()) @map("created_at")
  updatedAt        DateTime                       @updatedAt @map("updated_at")

  @@index([participantId, archivedAt, createdAt])
  @@index([participantId, kind])
  @@map("event_participant_documents")
}

