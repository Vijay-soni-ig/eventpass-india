generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// V1 legacy enum — kept for backward compatibility with existing routes.
// Not used by any new V2 model.
// ---------------------------------------------------------------------------
enum UserType {
  visitor
  exhibitor
}

enum PlatformRole {
  super_admin
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String?
  phone        String?
  userType     UserType      @default(visitor)
  platformRole PlatformRole?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  // --- V1 legacy relations (kept, still used by existing routes) ---
  business        ExhibitorBusiness?
  exhibitions     Exhibition[]
  ticketBookings  TicketBooking[]
  stallBookings   StallBooking[]
  teamMemberships TeamMember[]

  // --- V2 relations ---
  organizerMemberships OrganizerMembership[]
  exhibitorMemberships ExhibitorMembership[]
  checkIns             CheckIn[]
  leadsCaptured        Lead[]
  auditLogs            AuditLog[]
  documentsUploaded    Document[]

  @@map("users")
}

enum KycStatus {
  pending
  verified
}

// ---------------------------------------------------------------------------
// ORGANIZER — owns Exhibitions. New in V2.
// ---------------------------------------------------------------------------
model Organizer {
  id                  String    @id @default(uuid())
  name                String
  businessType        String?
  address             String?
  gst                 String?
  pan                 String?
  website             String?
  logoUrl             String?
  brandPrimaryColor   String?
  brandSecondaryColor String?
  kycStatus           KycStatus @default(pending)
  bankAccountName     String?
  bankAccountNumber   String?
  bankIfsc            String?
  bankVerified        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  memberships OrganizerMembership[]
  exhibitions Exhibition[]

  @@map("organizers")
}

enum OrganizerMemberRole {
  owner
  admin
  operations
  finance
  marketing
  scanner
}

enum OrganizerMemberStatus {
  active
  invited
}

model OrganizerMembership {
  id           String                @id @default(uuid())
  organizerId  String
  organizer    Organizer             @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitedEmail String?
  role         OrganizerMemberRole
  status       OrganizerMemberStatus @default(invited)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([organizerId, userId])
  @@index([organizerId])
  @@index([userId])
  @@map("organizer_memberships")
}

// ---------------------------------------------------------------------------
// EXHIBITOR — participates in Exhibitions. Repurposed from V1's
// ExhibitorBusiness (which previously doubled as an exhibition owner).
// ---------------------------------------------------------------------------
model ExhibitorBusiness {
  id                  String    @id @default(uuid())
  ownerId             String    @unique
  owner               User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyName         String?
  businessType        String?
  address             String?
  gst                 String?
  pan                 String?
  website             String?
  logoUrl             String?
  brandPrimaryColor   String?
  brandSecondaryColor String?
  kycStatus           KycStatus @default(pending)
  bankAccountName     String?
  bankAccountNumber   String?
  bankIfsc            String?
  taxCategory         String?
  invoicePreference   String?
  bankVerified        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // --- V1 legacy relation (kept, still used by existing routes) ---
  teamMembers TeamMember[]

  // --- V2 relations ---
  memberships    ExhibitorMembership[]
  participations ExhibitionExhibitor[]
  documents      Document[]

  @@map("exhibitor_businesses")
}

// ---------------------------------------------------------------------------
// DOCUMENT — files an exhibitor business uploads for KYC/verification
// purposes (GST certificate, ID proof, etc). Foundation-level: upload/list/
// delete only, no verification workflow yet.
// ---------------------------------------------------------------------------
model Document {
  id                  String            @id @default(uuid())
  exhibitorBusinessId String
  business            ExhibitorBusiness @relation(fields: [exhibitorBusinessId], references: [id], onDelete: Cascade)
  uploadedByUserId    String?
  uploadedByUser      User?             @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  name                String
  fileUrl             String
  createdAt           DateTime          @default(now())

  @@index([exhibitorBusinessId])
  @@map("documents")
}

// V1 legacy role/status enums — kept for TeamMember only.
enum TeamRole {
  owner
  finance
  operations
  marketing
  scanner
}

enum TeamMemberStatus {
  active
  invited
}

// V1 legacy model — superseded by OrganizerMembership / ExhibitorMembership.
// Kept as-is (existing routes still read/write it); not extended further.
model TeamMember {
  id           String            @id @default(uuid())
  businessId   String
  business     ExhibitorBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedEmail String
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  role         TeamRole
  status       TeamMemberStatus  @default(invited)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([businessId])
  @@index([userId])
  @@map("team_members")
}

enum ExhibitorMemberRole {
  owner
  admin
  staff
}

enum ExhibitorMemberStatus {
  active
  invited
}

model ExhibitorMembership {
  id                  String                @id @default(uuid())
  exhibitorBusinessId String
  business            ExhibitorBusiness     @relation(fields: [exhibitorBusinessId], references: [id], onDelete: Cascade)
  userId              String?
  user                User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitedEmail        String?
  role                ExhibitorMemberRole
  status              ExhibitorMemberStatus @default(invited)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([exhibitorBusinessId, userId])
  @@index([exhibitorBusinessId])
  @@index([userId])
  @@map("exhibitor_memberships")
}

enum ExhibitionStatus {
  draft
  live
  paused
  completed
}

enum Visibility {
  public
  private
}

model Exhibition {
  id            String           @id @default(uuid())
  // --- V1 legacy field — kept for backward compatibility, no longer the
  // source of truth for "who runs this exhibition". See organizerId.
  ownerId       String
  owner         User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  // --- V2 field — the real tenant root for an exhibition ---
  organizerId   String
  organizer     Organizer        @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  name          String
  category      String?
  description   String?
  venue         String?
  city          String?
  startDate     DateTime?        @db.Date
  endDate       DateTime?        @db.Date
  coverImageUrl String?
  floorPlanUrl  String?
  status        ExhibitionStatus @default(draft)
  visibility    Visibility       @default(public)
  refundPolicy  String?
  terms         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  ticketTypes          TicketType[]
  stalls               Stall[]
  ticketBookings       TicketBooking[]
  stallBookings        StallBooking[]
  exhibitionExhibitors ExhibitionExhibitor[]

  @@index([ownerId])
  @@index([organizerId])
  @@map("exhibitions")
}

// Exhibitor participation lifecycle:
//   applied -> approved -> stall_reserved -> payment_pending -> confirmed
//   applied -> rejected
//   (approved | stall_reserved | payment_pending | confirmed) -> cancelled
enum ParticipationStatus {
  applied
  approved
  rejected
  stall_pending
  stall_reserved
  payment_pending
  confirmed
  cancelled
}

// ---------------------------------------------------------------------------
// EXHIBITION <-> EXHIBITOR participation. New in V2 — this is the
// relationship that replaces the old "exhibitor owns the exhibition" model.
// ---------------------------------------------------------------------------
model ExhibitionExhibitor {
  id                  String              @id @default(uuid())
  exhibitionId        String
  exhibition          Exhibition          @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  exhibitorBusinessId String
  business            ExhibitorBusiness   @relation(fields: [exhibitorBusinessId], references: [id], onDelete: Cascade)
  status              ParticipationStatus @default(applied)
  boothNumber         String?
  invitedAt           DateTime            @default(now())
  confirmedAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  stalls        Stall[]
  stallBookings StallBooking[]
  leads         Lead[]

  // Prevents the same exhibitor company from being registered twice for
  // the same exhibition (requirement: no duplicate participation).
  @@unique([exhibitionId, exhibitorBusinessId])
  @@index([exhibitionId])
  @@index([exhibitorBusinessId])
  @@map("exhibition_exhibitors")
}

model TicketType {
  id           String     @id @default(uuid())
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  name         String
  price        Decimal    @default(0) @db.Decimal(10, 2)
  quantity     Int        @default(0)
  taxPercent   Decimal    @default(0) @db.Decimal(5, 2)
  visible      Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  bookings TicketBooking[]

  @@index([exhibitionId])
  @@map("ticket_types")
}

enum StallType {
  premium
  standard
  basic
}

enum StallStatus {
  available
  reserved
  sold
}

model Stall {
  id                    String               @id @default(uuid())
  exhibitionId          String
  exhibition            Exhibition           @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  code                  String?
  stallType             StallType?
  size                  String?
  price                 Decimal              @default(0) @db.Decimal(10, 2)
  status                StallStatus          @default(available)
  posX                  Decimal?             @db.Decimal(10, 2)
  posY                  Decimal?             @db.Decimal(10, 2)
  width                 Decimal?             @db.Decimal(10, 2)
  height                Decimal?             @db.Decimal(10, 2)
  // --- V1 legacy fields — kept for backward compatibility. Superseded by
  // exhibitionExhibitorId, which is a proper relation instead of free text.
  buyerName             String?
  buyerEmail            String?
  // --- V2 field — a stall can be allocated to at most one exhibitor
  // participation, which by construction prevents duplicate allocation.
  exhibitionExhibitorId String?
  exhibitionExhibitor   ExhibitionExhibitor? @relation(fields: [exhibitionExhibitorId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  bookings StallBooking[]

  @@index([exhibitionId])
  @@index([exhibitionExhibitorId])
  @@map("stalls")
}

// Payment lifecycle: created (order placed with the gateway, no attempt
// yet) -> pending (webhook says an attempt is in flight / awaiting async
// confirmation, e.g. UPI collect) -> paid (verified success) | failed |
// cancelled. paid -> refunded is the only transition out of a terminal
// success state.
enum PaymentStatus {
  created
  pending
  paid
  failed
  cancelled
  refunded
}

// ---------------------------------------------------------------------------
// PAYMENT — the single record of a real (or, in mock mode, simulated but
// still signature-verified) payment attempt against a gateway order.
// TicketBooking/StallBooking keep their own legacy amountPaid/paymentStatus
// fields for backward compatibility, but this table — not a frontend
// claim — is what actually gates a booking's CONFIRMED state.
// ---------------------------------------------------------------------------
model Payment {
  id                String        @id @default(uuid())
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  gateway           String?
  gatewayRefId      String?
  // --- V3 fields: production payment architecture ---
  provider          String?
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  failureReason     String?
  metadata          Json?
  status            PaymentStatus @default(created)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  ticketBooking TicketBooking?
  stallBooking  StallBooking?
  events        PaymentEvent[]

  @@index([status])
  @@index([providerOrderId])
  @@map("payments")
}

// ---------------------------------------------------------------------------
// PAYMENT EVENT — every webhook/callback received for a payment, keyed by
// (provider, providerEventId) so a duplicate delivery (gateways routinely
// retry webhooks) is a no-op rather than double-processing.
// ---------------------------------------------------------------------------
model PaymentEvent {
  id              String   @id @default(uuid())
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider        String
  providerEventId String
  eventType       String
  payload         Json
  createdAt       DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([paymentId])
  @@map("payment_events")
}

model TicketBooking {
  id            String        @id @default(uuid())
  exhibitionId  String
  exhibition    Exhibition    @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  ticketTypeId  String?
  ticketType    TicketType?   @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  buyerUserId   String?
  buyerUser     User?         @relation(fields: [buyerUserId], references: [id], onDelete: SetNull)
  attendeeName  String?
  attendeeEmail String?
  attendeePhone String?
  quantity      Int           @default(1)
  unitPrice     Decimal       @default(0) @db.Decimal(10, 2)
  // --- V1 legacy payment/check-in fields — kept for backward compatibility,
  // still used by existing routes. Superseded by Payment / CheckIn.
  amountPaid    Decimal       @default(0) @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(created)
  checkInStatus Boolean       @default(false)
  checkInTime   DateTime?
  // --- V2 fields ---
  paymentId     String?       @unique
  payment       Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  qrCode        String        @unique @default(uuid())
  visitDate     DateTime?     @db.Date
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  checkIns CheckIn[]
  leads    Lead[]

  @@index([exhibitionId])
  @@index([ticketTypeId])
  @@index([buyerUserId])
  @@map("ticket_bookings")
}

model StallBooking {
  id                    String               @id @default(uuid())
  stallId               String
  stall                 Stall                @relation(fields: [stallId], references: [id], onDelete: Cascade)
  exhibitionId          String
  exhibition            Exhibition           @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  buyerUserId           String?
  buyerUser             User?                @relation(fields: [buyerUserId], references: [id], onDelete: SetNull)
  // --- V1 legacy fields — kept for backward compatibility ---
  buyerName             String?
  buyerEmail            String?
  amountPaid            Decimal              @default(0) @db.Decimal(10, 2)
  paymentStatus         PaymentStatus        @default(created)
  // --- V2 fields ---
  paymentId             String?              @unique
  payment               Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  exhibitionExhibitorId String?
  exhibitionExhibitor   ExhibitionExhibitor? @relation(fields: [exhibitionExhibitorId], references: [id], onDelete: SetNull)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([stallId])
  @@index([exhibitionId])
  @@index([buyerUserId])
  @@index([exhibitionExhibitorId])
  @@map("stall_bookings")
}

enum CheckInMethod {
  qr
  manual
}

// ---------------------------------------------------------------------------
// CHECK-IN — append-only scan history. New in V2, replaces the flat
// checkInStatus/checkInTime pair (which is kept on TicketBooking for
// backward compatibility, but is no longer the audit trail).
// ---------------------------------------------------------------------------
model CheckIn {
  id              String        @id @default(uuid())
  ticketBookingId String
  ticketBooking   TicketBooking @relation(fields: [ticketBookingId], references: [id], onDelete: Cascade)
  scannedByUserId String?
  scannedByUser   User?         @relation(fields: [scannedByUserId], references: [id], onDelete: SetNull)
  method          CheckInMethod @default(qr)
  scannedAt       DateTime      @default(now())

  @@index([ticketBookingId])
  @@index([scannedByUserId])
  @@map("check_ins")
}

enum LeadStatus {
  new
  contacted
  qualified
  converted
  dropped
}

// ---------------------------------------------------------------------------
// LEAD — captured when an exhibitor scans a visitor's ticket at their
// stall. New in V2, foundation only (no capture route wired up yet).
// ---------------------------------------------------------------------------
model Lead {
  id                    String              @id @default(uuid())
  exhibitionExhibitorId String
  exhibitionExhibitor   ExhibitionExhibitor @relation(fields: [exhibitionExhibitorId], references: [id], onDelete: Cascade)
  ticketBookingId       String?
  ticketBooking         TicketBooking?      @relation(fields: [ticketBookingId], references: [id], onDelete: SetNull)
  capturedByUserId      String?
  capturedByUser        User?               @relation(fields: [capturedByUserId], references: [id], onDelete: SetNull)
  notes                 String?
  status                LeadStatus          @default(new)
  capturedAt            DateTime            @default(now())
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([exhibitionExhibitorId])
  @@index([ticketBookingId])
  @@index([capturedByUserId])
  @@map("leads")
}

// ---------------------------------------------------------------------------
// AUDIT LOG — cross-cutting trace of who changed what. New in V2,
// foundation only (not yet written to by any route).
// ---------------------------------------------------------------------------
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
