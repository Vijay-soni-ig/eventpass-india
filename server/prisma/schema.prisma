model Exhibition {
  id                   String                @id @default(uuid())
  ownerId              String
  owner                User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organizerId          String
  organizer            Organizer             @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  name                 String
  category             String?
  description          String?
  venue                String?
  city                 String?
  latitude             Float?
  longitude            Float?
  startDate            DateTime?             @db.Date
  endDate              DateTime?             @db.Date
  coverImageUrl        String?
  floorPlanUrl         String?
  status               ExhibitionStatus      @default(draft)
  visibility           Visibility            @default(public)
  refundPolicy         String?
  terms                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  // ETX-EVENT-001B — link to this Exhibition's universal Event row.
  // Nullable and unenforced by any route: Exhibition remains the sole
  // operational source of truth (payments/bookings/floor-plan/etc. still
  // key off exhibitionId everywhere, unchanged). @unique makes this a real
  // 1:1 — one Event can never be claimed by two Exhibitions. Populated only
  // by the idempotent backfill in server/src/lib/eventBackfill.ts, never by
  // application routes yet (no dual-write until ETX-EVENT-001C+), so a
  // freshly created Exhibition has eventId = null until the backfill next
  // runs. See docs/product/UNIVERSAL_EVENT_FOUNDATION.md.
  eventId              String?               @unique
  event                Event?                @relation(fields: [eventId], references: [id], onDelete: SetNull)
  ticketTypes          TicketType[]
  stalls               Stall[]
  ticketBookings       TicketBooking[]
  stallBookings        StallBooking[]
  exhibitionExhibitors ExhibitionExhibitor[]
  savedByUsers         SavedExhibition[]
  media                ExhibitionMedia[]
  schedules            ExhibitionSchedule[]
  faqs                 ExhibitionFAQ[]
  highlights           ExhibitionHighlight[]
  audiences            ExhibitionAudience[]
  floorPlans           FloorPlan[]

  @@index([ownerId])
  @@index([organizerId])
  @@index([status, visibility])
  @@map("exhibitions")
}

