enum EventVendorServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model EventVendorService {
  id          String                   @id @default(uuid())
  eventId     String
  event       Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
