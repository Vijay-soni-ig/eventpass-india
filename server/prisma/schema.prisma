generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// V1 legacy enum — kept for backward compatibility with existing routes.
// Not used by any new V2 model.
// ---------------------------------------------------------------------------
enum UserType {
  visitor
  exhibitor
  organizer
}

enum PlatformRole {
  super_admin
}

model User {
  id                           String                  @id @default(uuid())
  email                        String                  @unique
  passwordHash                 String
  fullName                     String?
  phone                        String?
  userType                     UserType                @default(visitor)
  platformRole                 PlatformRole?
  suspended                    Boolean                 @default(false)
  suspendedReason              String?
  suspendedAt                  DateTime?
  createdAt                    DateTime                @default(now())
  updatedAt                    DateTime                @updatedAt
  business                     ExhibitorBusiness?
  exhibitions                  Exhibition[]
  // ETX-EVENT-001A — universal Event foundation, additive only (see Organizer.events).
  eventsOwned                  Event[]
  ticketBookings               TicketBooking[]
  stallBookings                StallBooking[]
  teamMemberships              TeamMember[]
  organizerMemberships         OrganizerMembership[]
  exhibitorMemberships         ExhibitorMembership[]
  checkIns                     CheckIn[]
  leadsCaptured                Lead[]                  @relation("LeadCapturedBy")
  leadsAssigned                Lead[]                  @relation("LeadAssignedTo")
  auditLogs                    AuditLog[]
  documentsUploaded            Document[]
  refundsRequested             Refund[]
  supportTicketsRequested      SupportTicket[]         @relation("SupportTicketRequester")
  supportTicketsAssigned       SupportTicket[]         @relation("SupportTicketAssignee")
  supportTicketMessages        SupportTicketMessage[]
  organizerFollows             OrganizerFollow[]
  savedExhibitions             SavedExhibition[]
  organizerGalleryMediaCreated OrganizerGalleryMedia[]
  participantMediaUploads    EventParticipantMedia[]
  participantDocumentUploads EventParticipantDocument[]
  notifications                Notification[]
  eventLeads                   EventLead[] @relation("EventLeadVisitor")
  assignedEventLeads           EventLead[] @relation("EventLeadAssignee")
  capturedEventLeads           EventLead[] @relation("EventLeadCapturedBy")
  eventLeadInteractions        EventLeadInteraction[] @relation("EventLeadInteractionCreator")
  eventLeadFollowUps           EventLeadFollowUp[] @relation("EventLeadFollowUpAssignee")
  notificationPreference       NotificationPreference?
  registrations                EventRegistration[]
  eventTicketReservations       EventTicketReservation[]
  eventTicketOrders              EventTicketOrder[]
  eventTickets                   EventTicket[]
  eventTicketCheckIns             EventTicketCheckIn[] @relation("EventTicketCheckInScanner")
  organizerBootstrapped        Organizer?
  visitorInteractions          VisitorEventInteraction[]
  visitorPreference             VisitorPreference?

  @@map("users")
}

enum KycStatus {
  pending
  verified
}

model Organizer {
  id                   String                  @id @default(uuid())
  name                 String
  businessType         String?
  address              String?
  gst                  String?
  pan                  String?
  website              String?
  logoUrl              String?
  brandPrimaryColor    String?
  brandSecondaryColor  String?
  kycStatus            KycStatus               @default(pending)
  bankAccountName      String?
  bankAccountNumber    String?
  bankIfsc             String?
  bankVerified         Boolean                 @default(false)
  slug                 String?                 @unique
  description          String?
  coverImageUrl        String?
  city                 String?
  state                String?
  country              String?
  publicEmail          String?
  publicPhone          String?
  publicProfileEnabled Boolean                 @default(false)
  suspended            Boolean                 @default(false)
  suspendedReason      String?
  suspendedAt          DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  bootstrappedByUserId String?                 @unique
  bootstrappedByUser   User?                   @relation(fields: [bootstrappedByUserId], references: [id], onDelete: SetNull)
  memberships          OrganizerMembership[]
  exhibitions          Exhibition[]
  // ETX-EVENT-001A — universal Event foundation. Additive only: no existing
  // Exhibition relation above is touched. See EventCategory/Event models
  // near the end of this file and docs/product/UNIVERSAL_EVENT_FOUNDATION.md.
  events               Event[]
  subscriptions        Subscription[]
  supportTickets       SupportTicket[]
  socialLinks          OrganizerSocialLink[]
  follows              OrganizerFollow[]
  galleryMedia         OrganizerGalleryMedia[]
  notifications        Notification[]
  venues               Venue[]

  @@index([publicProfileEnabled, suspended])
  @@map("organizers")
}

enum VenueStatus {
  active
  inactive
  archived
}

enum VenueBuildingStatus {
  active
  inactive
  archived
}

enum VenueEntranceStatus {
  active
  inactive
  archived
}

enum VenueEntranceType {
  main
  secondary
  emergency
  service
  staff
  other
}

enum VenueParkingAreaStatus {
  active
  inactive
  archived
}

enum VenueParkingType {
  surface
  covered
  basement
  multilevel
  valet
  other
}

model VenueParkingArea {
  id                String                 @id @default(uuid())
  venueId           String
  venue             Venue                  @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name              String
  code              String?
  description       String?
  type              VenueParkingType       @default(surface)
  totalSpaces       Int
  accessibleSpaces  Int                    @default(0)
  evChargingSpaces  Int                    @default(0)
  sortOrder         Int                    @default(0)
  status            VenueParkingAreaStatus @default(active)
  archivedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([venueId, name])
  @@unique([venueId, code])
  @@index([venueId, status, sortOrder])
  @@index([venueId, type])
  @@map("venue_parking_areas")
}

model VenueEntrance {
  id              String             @id @default(uuid())
  venueId         String
  venue           Venue              @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorId         String?
  floor           VenueFloor?        @relation(fields: [floorId], references: [id], onDelete: SetNull)
  name            String
  code            String?
  description     String?
  type            VenueEntranceType  @default(main)
  isAccessible    Boolean            @default(true)
  isEmergencyExit Boolean            @default(false)
  isPublic        Boolean            @default(true)
  sortOrder       Int                @default(0)
  status          VenueEntranceStatus @default(active)
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  mapObjects      VenueMapObject[]

  @@unique([venueId, name])
  @@unique([venueId, code])
  @@index([venueId, status, sortOrder])
  @@index([venueId, type])
  @@index([floorId])
  @@map("venue_entrances")
}


enum VenueFacilityStatus {
  active
  inactive
  archived
}

enum VenueFacilityType {
  restroom
  accessible_restroom
  first_aid
  medical_room
  information_desk
  cloakroom
  food_beverage
  atm
  wifi
  charging_station
  prayer_room
  security
  lost_found
  baby_care
  drinking_water
  elevator
  escalator
  other
}

model VenueFacility {
  id              String              @id @default(uuid())
  venueId         String
  venue           Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorId         String?
  floor           VenueFloor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  spaceId         String?
  space           VenueSpace?         @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name            String
  code            String?
  description     String?
  type            VenueFacilityType   @default(other)
  quantity        Int                 @default(1)
  isAccessible    Boolean             @default(true)
  isPublic        Boolean             @default(true)
  sortOrder       Int                 @default(0)
  status          VenueFacilityStatus @default(active)
  archivedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([venueId, name])
  @@unique([venueId, code])
  @@index([venueId, status, sortOrder])
  @@index([venueId, type])
  @@index([floorId])
  @@index([spaceId])
  @@map("venue_facilities")
}

enum VenueSeatingAreaStatus {
  active
  inactive
  archived
}

enum VenueSeatingType {
  fixed
  movable
  bleacher
  auditorium
  classroom
  theater
  banquet
  cabaret
  other
}

model VenueSeatingArea {
  id                String              @id @default(uuid())
  venueId           String
  venue             Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorId           String?
  floor             VenueFloor?         @relation(fields: [floorId], references: [id], onDelete: SetNull)
  spaceId           String?
  space             VenueSpace?         @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name              String
  code              String?
  description       String?
  type              VenueSeatingType   @default(fixed)
  capacity          Int
  accessibleSeats   Int                 @default(0)
  rowCount          Int?
  seatsPerRow       Int?
  sortOrder         Int                 @default(0)
  status            VenueSeatingAreaStatus @default(active)
  archivedAt        DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@unique([venueId, name])
  @@unique([venueId, code])
  @@index([venueId, status, sortOrder])
  @@index([venueId, type])
  @@index([floorId])
  @@index([spaceId])
  @@map("venue_seating_areas")
}

enum VenueFloorStatus {
  active
  inactive
  archived
}

model Venue {
  id            String      @id @default(uuid())
  organizerId   String
  organizer     Organizer   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  name          String
  code          String?
  description   String?
  address       String?
  city          String?
  state         String?
  country       String      @default("India")
  postalCode    String?
  latitude      Float?
  longitude     Float?
  status        VenueStatus @default(active)
  archivedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  buildings     VenueBuilding[]
  entrances     VenueEntrance[]
  parkingAreas  VenueParkingArea[]
  facilities    VenueFacility[]
  seatingAreas  VenueSeatingArea[]
  availabilityBlocks VenueAvailabilityBlock[]
  maintenanceBlocks VenueMaintenanceBlock[]
  maps           VenueMap[]
  events         Event[]

  @@unique([organizerId, name])
  @@unique([organizerId, code])
  @@index([organizerId, status])
  @@index([organizerId, city])
  @@map("venues")
}

model VenueBuilding {
  id          String              @id @default(uuid())
  venueId     String
  venue       Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  sortOrder   Int                 @default(0)
  status      VenueBuildingStatus @default(active)
  archivedAt  DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  floors      VenueFloor[]

  @@unique([venueId, name])
  @@unique([venueId, code])
  @@index([venueId, status, sortOrder])
  @@map("venue_buildings")
}

model VenueFloor {
  id          String           @id @default(uuid())
  buildingId  String
  building    VenueBuilding    @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  level       Int
  description String?
  sortOrder   Int              @default(0)
  status      VenueFloorStatus @default(active)
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  zones       VenueZone[]
  entrances   VenueEntrance[]
  facilities  VenueFacility[]
  seatingAreas VenueSeatingArea[]
  maps        VenueMap[]
  availabilityBlocks VenueAvailabilityBlock[]
  maintenanceBlocks VenueMaintenanceBlock[]

  @@unique([buildingId, name])
  @@unique([buildingId, level])
  @@unique([buildingId, code])
  @@index([buildingId, status, sortOrder])
  @@map("venue_floors")
}

enum VenueZoneStatus {
  active
  inactive
  archived
}

enum VenueZoneType {
  public_area
  exhibition_area
  registration
  lobby
  meeting
  food_beverage
  service
  restricted
  other
}

enum VenueSpaceStatus {
  active
  inactive
  archived
}

enum VenueSpaceType {
  room
  meeting_room
  conference_room
  auditorium
  hall
  office
  storage
  service_room
  other
}

model VenueZone {
  id          String          @id @default(uuid())
  floorId     String
  floor       VenueFloor      @relation(fields: [floorId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  type        VenueZoneType   @default(other)
  sortOrder   Int             @default(0)
  status      VenueZoneStatus @default(active)
  archivedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  spaces      VenueSpace[]
  mapObjects  VenueMapObject[]

  @@unique([floorId, name])
  @@unique([floorId, code])
  @@index([floorId, status, sortOrder])
  @@index([floorId, type])
  @@map("venue_zones")
}


enum VenueCapacityRuleStatus {
  active
  inactive
  archived
}

model VenueSpace {
  id          String           @id @default(uuid())
  zoneId      String
  zone        VenueZone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  description String?
  type        VenueSpaceType   @default(room)
  sortOrder   Int              @default(0)
  status      VenueSpaceStatus @default(active)
  archivedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  capacityRules VenueCapacityRule[]
  facilities VenueFacility[]
  seatingAreas VenueSeatingArea[]
  mapObjects VenueMapObject[]
  availabilityBlocks VenueAvailabilityBlock[]
  maintenanceBlocks VenueMaintenanceBlock[]

  @@unique([zoneId, name])
  @@unique([zoneId, code])
  @@index([zoneId, status, sortOrder])
  @@index([zoneId, type])
  @@map("venue_spaces")
}

model VenueCapacityRule {
  id                 String                   @id @default(uuid())
  spaceId            String
  space              VenueSpace               @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name               String
  maxOccupancy       Int
  seatedCapacity     Int?
  standingCapacity   Int?
  wheelchairCapacity Int?
  notes              String?
  status             VenueCapacityRuleStatus  @default(active)
  archivedAt         DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@unique([spaceId, name])
  @@index([spaceId, status])
  @@map("venue_capacity_rules")
}

enum VenueMapStatus {
  draft
  published
  archived
}

enum VenueMapObjectType {
  entrance
  zone
  space
  facility
  seating
  parking
  custom
}

model VenueMap {
  id           String          @id @default(uuid())
  venueId      String
  venue        Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorId      String?
  floor        VenueFloor?     @relation(fields: [floorId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  backgroundUrl String?
  canvasWidth  Decimal         @db.Decimal(12, 2)
  canvasHeight Decimal         @db.Decimal(12, 2)
  version      Int             @default(1)
  status       VenueMapStatus  @default(draft)
  publishedAt  DateTime?
  archivedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  objects      VenueMapObject[]

  @@unique([venueId, name])
  @@index([venueId, status])
  @@index([floorId, status])
  @@map("venue_maps")
}

model VenueMapObject {
  id          String             @id @default(uuid())
  venueMapId  String
  venueMap    VenueMap           @relation(fields: [venueMapId], references: [id], onDelete: Cascade)
  type        VenueMapObjectType
  label       String?
  description String?
  spaceId     String?
  space       VenueSpace?        @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  zoneId      String?
  zone        VenueZone?         @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  entranceId  String?
  entrance    VenueEntrance?     @relation(fields: [entranceId], references: [id], onDelete: SetNull)
  x           Decimal            @db.Decimal(12, 2)
  y           Decimal            @db.Decimal(12, 2)
  width       Decimal            @db.Decimal(12, 2)
  height      Decimal            @db.Decimal(12, 2)
  rotation    Decimal            @default(0) @db.Decimal(7, 2)
  zIndex      Int                @default(0)
  isVisible   Boolean            @default(true)
  metadata    Json?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([venueMapId, zIndex])
  @@index([spaceId])
  @@index([zoneId])
  @@index([entranceId])
  @@map("venue_map_objects")
}

enum VenueAvailabilityBlockStatus {
  active
  inactive
  archived
}

enum VenueAvailabilityBlockType {
  closed
  reserved
  unavailable
  other
}

enum VenueMaintenanceBlockStatus {
  scheduled
  in_progress
  completed
  cancelled
  archived
}

enum VenueMaintenanceType {
  inspection
  cleaning
  repair
  upgrade
  safety
  other
}

model VenueAvailabilityBlock {
  id          String                       @id @default(uuid())
  venueId     String
  venue       Venue                        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorId     String?
  floor       VenueFloor?                  @relation(fields: [floorId], references: [id], onDelete: SetNull)
  spaceId     String?
  space       VenueSpace?                  @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  name        String
  description String?
  type        VenueAvailabilityBlockType   @default(closed)
  startsAt    DateTime
  endsAt      DateTime
  status      VenueAvailabilityBlockStatus @default(active)
  archivedAt  DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([venueId, status, startsAt, endsAt])
  @@index([floorId, startsAt, endsAt])
  @@index([spaceId, startsAt, endsAt])
  @@map("venue_availability_blocks")
}

model VenueMaintenanceBlock {
  id          String                       @id @default(uuid())
  venueId     String
  venue       Venue                        @relation(fields: [venueId], references: [id], onDelete: Cascade)
  floorId     String?
  floor       VenueFloor?                  @relation(fields: [floorId], references: [id], onDelete: SetNull)
  spaceId     String?
  space       VenueSpace?                  @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  title       String
  description String?
  type        VenueMaintenanceType         @default(inspection)
  startsAt    DateTime
  endsAt      DateTime
  status      VenueMaintenanceBlockStatus   @default(scheduled)
  archivedAt  DateTime?
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@index([venueId, status, startsAt, endsAt])
  @@index([floorId, startsAt, endsAt])
  @@index([spaceId, startsAt, endsAt])
  @@map("venue_maintenance_blocks")
}

model OrganizerSocialLink {
  id          String    @id @default(uuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  platform    String
  url         String
  sortOrder   Int       @default(0)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([organizerId])
  @@map("organizer_social_links")
}

model OrganizerFollow {
  id          String    @id @default(uuid())
  organizerId String
  organizer   Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([organizerId, userId])
  @@index([organizerId])
  @@index([userId])
  @@map("organizer_follows")
}

model SavedExhibition {
  id           String     @id @default(uuid())
  exhibitionId String
  exhibition   Exhibition @relation(fields: [exhibitionId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, exhibitionId])
  @@index([exhibitionId])
  @@index([userId])
  @@map("saved_exhibitions")
}

model OrganizerGalleryMedia {
  id              String    @id @default(uuid())
  organizerId     String
  organizer       Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  imageUrl        String
  caption         String?
  altText         String?
  sortOrder       Int       @default(0)
  isFeatured      Boolean   @default(false)
  active          Boolean   @default(true)
  archivedAt      DateTime?
  createdByUserId String?
  createdByUser   User?     @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizerId])
  @@index([organizerId, sortOrder])
  @@map("organizer_gallery_media")
}

enum NotificationType {
  EVENT_PUBLISHED
  EVENT_UPDATED
  EVENT_DATE_CHANGED
  EVENT_TICKETS_AVAILABLE
  ORGANIZER_PROFILE_UPDATED
  // Phase 31 (FP-06) — the notification dispatcher's IN_APP channel writes
  // here so it reuses the existing bell/list UI (src/components/notifications)
  // instead of building a second one. Not related to the follower-engagement
  // types above, which are populated by generateFollowerNotifications()
  // (server/src/lib/notificationService.ts) on a completely separate path.
  STALL_RESERVATION_EXPIRED
  REGISTRATION_SUBMITTED
  REGISTRATION_CONFIRMED
  REGISTRATION_CANCELLED
  PARTICIPANT_CREATED
  PARTICIPANT_UPDATED
  PARTICIPANT_SESSION_ASSIGNED
  PARTICIPANT_SPONSOR_PACKAGE_ASSIGNED
  PARTICIPANT_VENDOR_SERVICE_ASSIGNED
}

model Notification {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  message       String
  entityType    String
  entityId      String
  actionUrl     String
  organizerId   String?
  organizer     Organizer?       @relation(fields: [organizerId], references: [id], onDelete: SetNull)
  sourceVersion String
  readAt        DateTime?
  createdAt     DateTime         @default(now())

  @@unique([userId, entityId, type, sourceVersion])
  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id                      String   @id @default(uuid())
  userId                  String   @unique
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventPublished          Boolean  @default(true)
  eventUpdated            Boolean  @default(true)
  eventDateChanged        Boolean  @default(true)
  ticketsAvailable        Boolean  @default(true)
  organizerProfileUpdated Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@map("notification_preferences")
}

enum OrganizerMemberRole {
  owner
  admin
  operations
  finance
  marketing
  scanner
}

enum OrganizerMemberStatus {
  active
  invited
}

model OrganizerMembership {
  id           String                @id @default(uuid())
  organizerId  String
  organizer    Organizer             @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  invitedEmail String?
  role         OrganizerMemberRole
  status       OrganizerMemberStatus @default(invited)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([organizerId, userId])
  @@index([organizerId])
  @@index([userId])
  @@map("organizer_memberships")
}

model ExhibitorBusiness {
  id                  String                @id @default(uuid())
  ownerId             String                @unique
  owner               User                  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  companyName         String?
  businessType        String?
  address             String?
  gst                 String?
  pan                 String?
  website             String?
  logoUrl             String?
  brandPrimaryColor   String?
  brandSecondaryColor String?
  kycStatus           KycStatus             @default(pending)
  bankAccountName     String?
  bankAccountNumber   String?
  bankIfsc            String?
  taxCategory         String?
  invoicePreference   String?
  bankVerified        Boolean               @default(false)
  suspended           Boolean               @default(false)
  suspendedReason     String?
  suspendedAt         DateTime?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  teamMembers         TeamMember[]
  memberships         ExhibitorMembership[]
  participations      ExhibitionExhibitor[]
  eventLeads          EventLead[]
  documents           Document[]

  @@map("exhibitor_businesses")
}

model Document {
  id                  String            @id @default(uuid())
  exhibitorBusinessId String
