  code                  String?
  stallType             StallType?
  size                  String?
  price                 Decimal              @default(0) @db.Decimal(10, 2)
  status                StallStatus          @default(available)
  posX                  Decimal?             @db.Decimal(10, 2)
  posY                  Decimal?             @db.Decimal(10, 2)
  width                 Decimal?             @db.Decimal(10, 2)
  height                Decimal?             @db.Decimal(10, 2)
