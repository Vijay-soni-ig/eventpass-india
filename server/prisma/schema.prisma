// =============================================================================
// ETX-EVENT-001A — UNIVERSAL EVENT FOUNDATION (additive, schema-only)
// =============================================================================
// Introduces the future universal Event domain root as a standalone set of
// tables. Nothing here is read or written by any existing route yet, and
// nothing existing (Exhibition, TicketType, Stall, FloorPlan, FloorPlanObject,
// TicketBooking, StallBooking, ExhibitionExhibitor, CheckIn, Lead, Payment,
// Refund, PaymentEvent) is modified or related to these models in this step.
// See docs/product/UNIVERSAL_EVENT_FOUNDATION.md for the full analysis and
// the planned backfill/compatibility step (ETX-EVENT-001B) that will connect
// this to Exhibition — not part of this step.

enum EventType {
  EXHIBITION
  CONFERENCE
  WORKSHOP
  SEMINAR
  CONCERT
  FESTIVAL
  SPORTS
  COMMUNITY
  OTHER
}

// Deliberately a separate enum from ExhibitionStatus (draft/live/paused/
// completed), which is untouched. PUBLISHED is the universal-naming
// equivalent of Exhibition's "live"; CANCELLED has no Exhibition equivalent
// today and is added here for event types where a terminal non-completion
// state is meaningful.
enum EventStatus {
  DRAFT
  PUBLISHED
  PAUSED
  COMPLETED
  CANCELLED
}

enum EventModule {
  REGISTRATION
  TICKETING
  EXHIBITORS
  STALL_BOOKING
  FLOOR_PLAN
  CHECK_IN
  LEADS
  SPEAKERS
  SESSIONS
  SPONSORS
  VENDORS
  VOLUNTEERS
  SEATING
  ANALYTICS
}

model EventCategory {
  id               String          @id @default(uuid())
  name             String
  slug             String          @unique
  description      String?
  parentCategoryId String?
  // onDelete: Restrict — deleting a category that still has children must
  // fail rather than cascade, so a category tree can never be silently
  // wiped out by removing its root.
  parent           EventCategory?  @relation("EventCategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: Restrict)
  children         EventCategory[] @relation("EventCategoryHierarchy")
  active           Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  events           Event[]

  @@index([parentCategoryId])
  @@index([active])
  @@index([active, sortOrder])
  @@map("event_categories")
}

model Event {
  id                String                  @id @default(uuid())
  organizerId       String
  organizer         Organizer               @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  ownerId           String
  owner             User                    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  // No uniqueness constraint yet: a per-organizer unique slug is the likely
  // eventual design (mirrors Organizer.slug being globally unique because
  // organizers are the tenant root, whereas events are not), but that scope
  // hasn't been decided against real routing requirements. Left nullable and
  // unconstrained rather than guessing wrong; tighten in a later step once
  // the public event-detail URL scheme for non-exhibition event types exists.
  slug              String?
  description       String?
  eventType         EventType
  categoryId        String?
  category          EventCategory?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  status            EventStatus             @default(DRAFT)
  visibility        Visibility              @default(public)
  // Same date-only semantics as Exhibition.startDate/endDate (@db.Date) —
  // deliberately not upgraded to a full timestamp here.
  startDate         DateTime?               @db.Date
  endDate           DateTime?               @db.Date
  timezone          String                  @default("Asia/Kolkata")
  venue             String?
  city              String?
  latitude          Float?
  longitude         Float?
  coverImageUrl     String?
  refundPolicy      String?
  terms             String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  archivedAt        DateTime?
  moduleEnablements EventModuleEnablement[]
  registrations     EventRegistration[]
  registrationSettings EventRegistrationSettings?
  // ETX-EVENT-001B — opposite side of Exhibition.eventId. Optional because
  // an Event created by a future non-exhibition flow (ETX-EVENT-001C+) will
  // never have one.
  exhibition        Exhibition?

  @@index([organizerId])
  @@index([ownerId])
  @@index([status, visibility])
  @@index([eventType])
  @@index([categoryId])
  @@index([startDate])
  @@map("events")
}

enum EventRegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum EventRegistrationSource {
  PUBLIC
  ORGANIZER
  ADMIN
}

model EventRegistrationSettings {
  id              String   @id @default(uuid())
  eventId         String   @unique
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(true)
  capacity        Int?
  requiresApproval Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("event_registration_settings")
}

model EventRegistration {
  id               String                  @id @default(uuid())
  eventId          String
  event            Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId           String?
  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  fullName         String
  email            String
  phone            String?
  companyName      String?
  status           EventRegistrationStatus @default(PENDING)
  source           EventRegistrationSource @default(PUBLIC)
  consentAccepted  Boolean                 @default(false)
  registeredAt     DateTime                @default(now())
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancellationReason String?
  idempotencyKey   String?
  metadata         Json?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([eventId, email])
  @@unique([eventId, idempotencyKey])
  @@index([eventId, status, createdAt])
  @@index([userId, eventId])
  @@index([email])
  @@map("event_registrations")
}

model EventModuleEnablement {
  id         String      @id @default(uuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  moduleType EventModule
  enabled    Boolean     @default(true)
  config     Json?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([eventId, moduleType])
  @@index([eventId])
  @@index([moduleType, enabled])
  @@map("event_module_enablements")
}
