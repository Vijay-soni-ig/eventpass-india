{
  "name": "eventpass-server",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:backfill-events": "tsx prisma/backfillEvents.ts",
    "reconcile:payments": "tsx scripts/reconcilePayments.ts",
    "test": "tsx --test --import ./tests/testSetup.ts --test-concurrency=1 tests/*.test.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.16.5",
    "@types/qrcode": "^1.5.6",
    "prisma": "^6.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "qs": "^6.16.0"
  }
}
